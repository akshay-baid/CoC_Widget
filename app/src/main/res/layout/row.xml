<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp">
    <ImageView android:id="@+id/bar" android:layout_width="match_parent" android:layout_height="36dp" android:scaleType="fitXY"/>
    <Chronometer android:id="@+id/timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical" android:layout_marginEnd="10dp"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:shadowColor="#000000" android:shadowRadius="3"/>
</FrameLayout>
